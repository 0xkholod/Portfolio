---
import "@fontsource-variable/space-grotesk";
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";
import { ClientRouter, fade } from "astro:transitions";
import SiteHeader from "../components/SiteHeader.astro";
import BrandIcon from "../components/BrandIcon.astro";

interface Props {
  title?: string;
  description?: string;
  current?: "home" | "about" | "journey" | "articles" | "credentials";
  image?: string;
  type?: "website" | "article";
  publishedAt?: Date;
  updatedAt?: Date;
}

const {
  title = "0xkholod — Systems & Offensive Security",
  description = "The personal site of Alejandro Gómez Kholodilov: systems administration, offensive security, certifications, and technical writing.",
  current = "home",
  image,
  type = "website",
  publishedAt,
  updatedAt,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const socialImageURL = image ? new URL(image, Astro.site ?? Astro.url) : undefined;
const quickFade = fade({ duration: "0.16s" });
---

<!doctype html>
<html lang="en" class="site-booting" transition:animate={quickFade}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    {socialImageURL && <meta property="og:image" content={socialImageURL} />}
    <meta name="twitter:card" content={socialImageURL ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImageURL && <meta name="twitter:image" content={socialImageURL} />}
    {type === "article" && publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    {type === "article" && updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}
    <meta name="theme-color" content="#080a11" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <style is:inline>
      html.site-booting body { visibility: hidden; opacity: 0; }
    </style>
    <ClientRouter fallback="animate" />
    <script is:inline>
      const revealPage = () => {
        document.documentElement.classList.remove("site-booting");
        document.documentElement.classList.add("site-ready");
      };

      const revealInitialPage = () => {
        const touchLayout = window.matchMedia("(hover: none), (pointer: coarse)").matches;
        const fontsReady = touchLayout && document.fonts ? document.fonts.ready : Promise.resolve();
        const fallback = new Promise((resolve) => window.setTimeout(resolve, 900));
        Promise.race([fontsReady, fallback]).then(() => window.requestAnimationFrame(revealPage));
      };

      document.addEventListener("astro:after-swap", revealPage);
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", revealInitialPage, { once: true });
      } else {
        revealInitialPage();
      }
    </script>
  </head>
  <body data-page={current}>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="cursor-glow" aria-hidden="true"></div>
    <canvas id="cursor-trail" aria-hidden="true"></canvas>
    <SiteHeader current={current} />
    <main id="main"><slot /></main>
    <footer class="site-footer shell">
      <a class="footer-mark" href="/" aria-label="0xkholod home"><span>𖦏</span> 0XKHOLOD</a>
      <div class="footer-socials" aria-label="Social profiles">
        <a class="github" href="https://github.com/0xkholod" target="_blank" rel="noreferrer" aria-label="GitHub"><BrandIcon name="github" size={18} /></a>
        <a class="htb" href="https://profile.hackthebox.com/profile/019e367d-68ab-7287-bd06-ec8449a07adb" target="_blank" rel="noreferrer" aria-label="Hack The Box"><BrandIcon name="htb" size={18} /></a>
        <a class="monkeytype" href="https://monkeytype.com/profile/0xkholod" target="_blank" rel="noreferrer" aria-label="Monkeytype"><BrandIcon name="monkeytype" size={19} /></a>
        <a class="linkedin" href="https://www.linkedin.com/in/alejandro-gomez-kholodilov" target="_blank" rel="noreferrer" aria-label="LinkedIn"><BrandIcon name="linkedin" size={18} /></a>
        <span class="youtube is-disabled" aria-label="YouTube coming soon" title="YouTube coming soon"><BrandIcon name="youtube" size={19} /></span>
      </div>
    </footer>
    <script src="../scripts/experience.ts"></script>
  </body>
</html>
