---
import { ArrowUpRight, Award, BookOpenCheck, ExternalLink, ShieldCheck, X } from "@lucide/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import BrandIcon from "../components/BrandIcon.astro";
---

<BaseLayout current="credentials" title="Credentials — 0xkholod" description="Verified offensive security credentials and current certification progress.">
  <section class="page-hero compact shell reveal">
    <p class="kicker">04 / CREDENTIALS</p>
    <h1>Certifications.<br /><span>Verified and in progress.</span></h1>
    <p class="page-lede">Open a credential to see its evidence, context, and verification links.</p>
  </section>

  <section class="credential-grid shell" aria-label="Certifications">
    <button id="cpts" class="credential-card badge-frame achieved tilt-card reveal" type="button" data-dialog="cpts-dialog">
      <span class="frame-status"><i></i> ACHIEVED</span>
      <ShieldCheck class="badge-check" size={22} />
      <span class="badge-orbit"><img src="/certifications/htb-cpts-badge.png" alt="" /></span>
      <span class="credential-card-detail">
        <span class="credential-issuer">HACK THE BOX</span>
        <strong>Certified Penetration Testing Specialist</strong>
        <span class="credential-footer"><small>04 SEP 2026</small><span>View credential <ArrowUpRight size={16} /></span></span>
      </span>
    </button>
    <button class="credential-card progress tilt-card reveal" type="button" data-dialog="cwes-dialog">
      <span class="credential-status"><i></i> IN PROGRESS</span>
      <div class="cwes-mark" aria-hidden="true"><span>W</span><i></i></div>
      <span class="credential-issuer">HACK THE BOX</span>
      <strong>Certified Web Exploitation Specialist</strong>
      <span class="progress-track"><i style="width: 60%"></i></span>
      <span class="credential-footer"><small>LEARNING PATH ≈ 60%</small><span>View progress <ArrowUpRight size={16} /></span></span>
    </button>
  </section>

  <dialog id="cpts-dialog" class="credential-dialog">
    <button class="dialog-close" type="button" data-close-dialog aria-label="Close credential"><X size={20} /></button>
    <div class="dialog-grid">
      <figure class="certificate-stage">
        <div class="certificate-art">
          <img src="/certifications/htb-cpts-certificate.jpg" alt="HTB Certified Penetration Testing Specialist certificate awarded to Alejandro Gómez Kholodilov" />
          <span class="certificate-glare" aria-hidden="true"></span>
        </div>
        <figcaption>HTBCERT-356ED9AD71 / ORIGINAL EVIDENCE</figcaption>
      </figure>
      <div class="dialog-copy">
        <div class="dialog-identity"><img src="/certifications/htb-cpts-badge.png" alt="HTB CPTS badge" /><span><small>ACHIEVED</small><b>HTB CPTS</b></span></div>
        <h2>Certified Penetration Testing Specialist</h2>
        <p>A hands-on assessment of end-to-end penetration testing: reconnaissance, exploitation, Active Directory, lateral movement, privilege escalation, pivoting, and professional reporting.</p>
        <dl>
          <div>
            <dt>Issuer</dt>
            <dd><a class="credential-issuer-link" href="https://www.hackthebox.com/" target="_blank" rel="noreferrer" aria-label="Visit Hack The Box"><BrandIcon name="htb" size={12} /> HTB</a></dd>
          </div>
          <div><dt>Issued</dt><dd>Sept. 4, 2026</dd></div>
          <div><dt>Credential</dt><dd>356ED9AD71</dd></div>
        </dl>
        <div class="dialog-actions">
          <a class="brand-action htb" href="https://profile.hackthebox.com/profile/019e367d-68ab-7287-bd06-ec8449a07adb/certificate/HTBCERT-356ED9AD71?utm_medium=copy_url" target="_blank" rel="noreferrer"><ShieldCheck size={18} /> Verify on HTB <ExternalLink size={15} /></a>
          <a class="brand-action credly" href="https://www.credly.com/badges/1bacf91c-938a-4d0c-84ad-382d27bd2365/public_url" target="_blank" rel="noreferrer"><Award size={18} /> View on Credly <ExternalLink size={15} /></a>
        </div>
      </div>
    </div>
  </dialog>

  <dialog id="cwes-dialog" class="credential-dialog progress-dialog">
    <button class="dialog-close" type="button" data-close-dialog aria-label="Close credential"><X size={20} /></button>
    <div class="progress-modal-visual"><div class="cwes-mark large" aria-hidden="true"><span>W</span><i></i></div><BookOpenCheck size={26} /></div>
    <div class="dialog-copy">
      <span class="credential-status"><i></i> IN PROGRESS</span>
      <h2>Certified Web Exploitation Specialist</h2>
      <p>Current specialization in modern web application assessment and exploitation, with an emphasis on understanding application behavior and producing evidence-driven reports.</p>
      <div class="modal-progress"><span><b>Web Penetration Tester path</b><small>Approximately 60% complete</small></span><div><i style="width:60%"></i></div></div>
    </div>
  </dialog>
</BaseLayout>
