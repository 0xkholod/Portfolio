---
import { ArrowUpRight, Award, BookOpenCheck, Clock3, ExternalLink, ShieldCheck, X } from "@lucide/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import BrandIcon from "../components/BrandIcon.astro";
import { achievedCredentials } from "../data/credentials";
---

<BaseLayout current="credentials" title="Credentials — 0xkholod" description="Verified HTB CPTS and CWES certifications, with OSCP preparation in progress.">
  <section class="page-hero compact shell reveal">
    <p class="kicker">04 / CREDENTIALS</p>
    <h1>Certifications.<br /><span>Verified and in progress.</span></h1>
    <p class="page-lede">Open a credential to see its evidence, context, and verification links.</p>
  </section>

  <section class="credential-grid shell" aria-label="Certifications">
    {achievedCredentials.map((credential) => (
      <button id={credential.id} class="credential-card badge-frame achieved tilt-card reveal" data-credential={credential.id} type="button" data-dialog={credential.id + "-dialog"} aria-haspopup="dialog">
        <span class="frame-status"><i></i> ACHIEVED</span>
        <ShieldCheck class="badge-check" size={22} />
        <span class="badge-orbit"><img src={credential.badge} alt={credential.alias + " badge"} width="132" height="132" /></span>
        <span class="credential-card-detail">
          <span class="credential-issuer">HACK THE BOX</span>
          <strong>{credential.title}</strong>
          <span class="credential-footer"><small><time datetime={credential.date}>{credential.cardDate}</time></small><span>View credential <ArrowUpRight size={16} /></span></span>
        </span>
      </button>
    ))}
    <button id="oscp" class="credential-card badge-frame progress tilt-card reveal" data-credential="oscp" type="button" data-dialog="oscp-dialog" aria-haspopup="dialog">
      <span class="credential-status"><i></i> IN PROGRESS</span>
      <BookOpenCheck class="badge-check" size={22} />
      <span class="oscp-mark" aria-hidden="true"><img src="/certifications/offsec-logo.svg" alt="" width="132" height="32" /><b>OSCP</b><small>PEN-200</small></span>
      <span class="credential-card-detail">
        <span class="credential-issuer">OFFSEC</span>
        <strong>OffSec Certified Professional</strong>
        <span class="credential-footer"><small>CURRENT FOCUS</small><span>View focus <ArrowUpRight size={16} /></span></span>
      </span>
    </button>
  </section>

  {achievedCredentials.map((credential) => (
    <dialog id={credential.id + "-dialog"} class="credential-dialog" data-credential={credential.id} aria-labelledby={credential.id + "-title"}>
      <button class="dialog-close" type="button" data-close-dialog aria-label="Close credential"><X size={20} /></button>
      <div class="dialog-grid">
        <figure class="certificate-stage">
          <div class="certificate-art">
            <picture>
              <source srcset={credential.certificateVector} type="image/svg+xml" />
              <img src={credential.certificate} alt={credential.alias + " certificate awarded to Alejandro Gómez Kholodilov"} loading="lazy" decoding="async" />
            </picture>
            <span class="certificate-glare" aria-hidden="true"></span>
          </div>
          <figcaption>HTBCERT-{credential.credential} / ORIGINAL EVIDENCE</figcaption>
        </figure>
        <div class="dialog-copy">
          <div class="dialog-identity"><img src={credential.badge} alt="" width="58" height="58" /><span><small>ACHIEVED</small><b>{credential.alias}</b></span></div>
          <h2 id={credential.id + "-title"}>{credential.title}</h2>
          <p>{credential.description}</p>
          <dl>
            <div>
              <dt>Issuer</dt>
              <dd><a class="credential-issuer-link" href="https://www.hackthebox.com/" target="_blank" rel="noreferrer" aria-label="Visit Hack The Box"><BrandIcon name="htb" size={12} /> HTB</a></dd>
            </div>
            <div><dt>Issued</dt><dd><time datetime={credential.date}>{credential.issued}</time></dd></div>
            <div><dt>Credential</dt><dd>{credential.credential}</dd></div>
          </dl>
          <div class="dialog-actions">
            {credential.htbUrl ? (
              <a class="brand-action htb" href={credential.htbUrl} target="_blank" rel="noreferrer"><ShieldCheck size={18} /> Verify on HTB <ExternalLink size={15} /></a>
            ) : (
              <button class="brand-action htb verification-pending" type="button" data-verification-notice={credential.id + "-verification-notice"} aria-expanded="false" aria-controls={credential.id + "-verification-notice"}><ShieldCheck size={18} /> Verify on HTB <Clock3 size={15} /></button>
            )}
            <a class="brand-action credly" href={credential.credlyUrl} target="_blank" rel="noreferrer"><Award size={18} /> View on Credly <ExternalLink size={15} /></a>
          </div>
          {!credential.htbUrl && (
            <p id={credential.id + "-verification-notice"} class="verification-notice" role="status" hidden>The public HTB verification link is expected to become available in the next few hours. You can already verify this certification on Credly.</p>
          )}
        </div>
      </div>
    </dialog>
  ))}

  <dialog id="oscp-dialog" class="credential-dialog progress-dialog" data-credential="oscp" aria-labelledby="oscp-title">
    <button class="dialog-close" type="button" data-close-dialog aria-label="Close credential"><X size={20} /></button>
    <div class="progress-modal-visual"><div class="oscp-mark large" aria-hidden="true"><img src="/certifications/offsec-logo.svg" alt="" width="150" height="36" /><b>OSCP</b><small>PEN-200</small></div><BookOpenCheck size={26} /></div>
    <div class="dialog-copy">
      <span class="credential-status"><i></i> IN PROGRESS</span>
      <h2 id="oscp-title">OffSec Certified Professional</h2>
      <p>Currently preparing for the OSCP, with a focus on infrastructure penetration testing, Active Directory, privilege escalation, and clear professional reporting.</p>
      <dl><div><dt>Issuer</dt><dd><a class="credential-issuer-link offsec" href="https://www.offsec.com/" target="_blank" rel="noreferrer" aria-label="Visit OffSec"><img src="/certifications/offsec-logo.svg" alt="OffSec" width="62" height="15" /></a></dd></div><div><dt>Training</dt><dd>PEN-200</dd></div><div><dt>Status</dt><dd>In progress</dd></div></dl>
      <div class="dialog-actions"><a class="brand-action offsec" href="https://www.offsec.com/courses/pen-200/" target="_blank" rel="noreferrer"><BookOpenCheck size={18} /> Explore PEN-200 <ExternalLink size={15} /></a></div>
    </div>
  </dialog>
</BaseLayout>
